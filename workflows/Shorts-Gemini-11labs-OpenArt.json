    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\"parts\": [{\"text\": \"You are a documentary writer. Select a verified topic under Wonders of World/Universe/Sea/India/Places. Write a 30-second script (~80 words). Write the \\\"script\\\" field in natural spoken Hindi (Devanagari), suitable for voiceover narration — keep \\\"topic\\\", \\\"openart_prompts\\\", and the \\\"youtube\\\" fields in English. Also write \\\"openart_prompts\\\": an array of exactly 3 distinct cinematic English visual descriptions, one per ~10-second video segment, together telling a coherent visual story that follows the script's narrative (different angles, moments, or details of the topic — not repeats of the same shot). Return ONLY a JSON object: {\\\"topic\\\": \\\"Topic Name\\\", \\\"script\\\": \\\"हिंदी में Voiceover text\\\", \\\"openart_prompts\\\": [\\\"scene 1 description\\\", \\\"...\\\", \\\"scene 3 description\\\"], \\\"youtube\\\": {\\\"title\\\": \\\"Title\\\", \\\"description\\\": \\\"Description #shorts\\\", \\\"tags\\\": [\\\"wonders\\\"]}}}}\"}]}],\n  \"generationConfig\": {\"responseMimeType\": \"application/json\"}\n}",
        "options": {}
      },
      "id": "0cf86767-eae5-4dfc-b70d-21ac5df13cdf",
      "name": "Generate Script (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        608
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "aprLxqbF5jUxabBq",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst data = JSON.parse(raw);\nconst prompts = data.openart_prompts || [];\nreturn prompts.map((p, i) => ({\n  json: {\n    scene: p,\n    sceneIndex: i,\n    topic: data.topic,\n    script: data.script,\n    youtube: data.youtube,\n  },\n}));"
      },
