        "googlePalmApi": {
          "id": "aprLxqbF5jUxabBq",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst data = JSON.parse(raw);\nconst prompts = data.openart_prompts || [];\nconst clipDurationSec = $node['Config'].json.clipDurationSec;\nreturn prompts.map((p, i) => ({\n  json: {\n    scene: p,\n    sceneIndex: i,\n    topic: data.topic,\n    script: data.script,\n    youtube: data.youtube,\n    clipDurationSec,\n  },\n}));"
      },
