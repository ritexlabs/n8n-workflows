      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\"parts\": [{\"text\": \"You are a documentary writer. Select a verified topic under Wonders of World/Universe/Sea/India/Places. Write a {{ $json.videoDurationSec }}-second script (~{{ Math.max(10, Math.round($json.videoDurationSec * 2.67)) }} words). Write the \\\"script\\\" field in natural spoken Hindi (Devanagari), suitable for voiceover narration — keep \\\"topic\\\", \\\"openart_prompts\\\", and the \\\"youtube\\\" fields in English. Also write \\\"openart_prompts\\\": an array of exactly {{ $json.sceneCount }} distinct cinematic English visual descriptions, one per ~{{ $json.clipDurationSec }}-second video segment, together telling a coherent visual story that follows the script's narrative (different angles, moments, or details of the topic — not repeats of the same shot). For \\\"youtube\\\", write a short catchy \\\"title\\\" (under 60 chars, with an emoji), a \\\"description\\\" that briefly summarizes the video then ends with 5-6 relevant, currently popular/trending hashtags for this topic on YouTube Shorts (always include #shorts, plus topic-specific ones like #wondersofworld, #didyouknow, #factsdaily as fitting — no generic unrelated tags), and \\\"tags\\\": an array of 8-10 relevant search keywords (no # symbol). Return ONLY a JSON object: {\\\"topic\\\": \\\"Topic Name\\\", \\\"script\\\": \\\"हिंदी में Voiceover text\\\", \\\"openart_prompts\\\": [array of exactly {{ $json.sceneCount }} scene description strings], \\\"youtube\\\": {\\\"title\\\": \\\"Catchy Title\\\", \\\"description\\\": \\\"Summary... #shorts #example\\\", \\\"tags\\\": [\\\"keyword1\\\", \\\"keyword2\\\"]}}}}\"}]}],\n  \"generationConfig\": {\"responseMimeType\": \"application/json\"}\n}",
        "options": {}
      },
